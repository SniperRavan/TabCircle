{
  "manifest_version": 3,
  "name": "TabCircle Bridge",
  "version": "0.14.0",
  "description": "Bridges the MRU tab order to the TabCircle helper and executes switch commands.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TabCircle — click for settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116"
}
